{
  "name": "smartedu-studysync",
  "version": "1.17.2",
  "description": "国家中小学智慧教育平台自学记录同步 (SmartEdu StudySync) — 学习进度监控、教材目录同步、错题整理与本地 CSV 导出扩展",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dingdingdang22/SmartEdu-StudySync.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "check-version": "node scripts/check-version.js",
    "version:sync": "node scripts/check-version.js --sync",
    "build": "node scripts/check-version.js && wxt build",
    "build:firefox": "node scripts/check-version.js && wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "node scripts/check-version.js && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wxt": "^0.19.28"
  }
}
